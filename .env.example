# Vision AI — Ollama-compatible endpoint (SAME protocol as hospitality-platform ai-vision.ts)
# Works with: local Ollama, remote Ollama, vLLM, or any OpenAI-compatible vision server.
AI_VISION_URL=http://localhost:11434
AI_VISION_MODEL=minicpm-v
# AI_VISION_TOKEN=            # optional bearer token if endpoint is behind a proxy
# Suggested models: minicpm-v (light), qwen2.5vl:7b, llama3.2-vision:11b, gemma3:12b (best quality/GB)

# Performance tuning
AI_VISION_MAX_EDGE=1024        # px, long edge sent to VLM (12MP→1024px ≈ 4× fewer vision tokens)
AI_VISION_JPEG_QUALITY=78      # JPEG re-encode quality
AI_VISION_CONCURRENCY=1        # keep 1 for local Ollama (multimodal parallel is unsafe — ollama#4165); raise for GPU/vLLM backends
ANALYSIS_MAX_IMAGES=24         # cap per claim

# Uploads
MAX_UPLOAD_MB=200

# Adjuster console access (shared PIN — swap for real SSO in production)
ADJUSTER_PIN=1234
SESSION_SECRET=change-me-to-a-long-random-string
